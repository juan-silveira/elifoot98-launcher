<Project Sdk="Microsoft.NET.Sdk">
  <!-- Launcher do Linux, do macOS e do Windows portatil (win-x86, sem depender do
       .NET Framework). Mesmas telas do launcher classico do Windows (src/),
       reaproveitando os codecs de save/arbitros/patch. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ElifootLauncher</RootNamespace>
    <AssemblyName>ElifootLauncher</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>../src/elifoot.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/SaveCodec.cs" Link="Shared/SaveCodec.cs" />
    <Compile Include="../src/TeamCodec.cs" Link="Shared/TeamCodec.cs" />
    <Compile Include="../src/Score.cs" Link="Shared/Score.cs" />
    <Compile Include="../src/RefereeCodec.cs" Link="Shared/RefereeCodec.cs" />
    <Compile Include="../src/PatchApplier.cs" Link="Shared/PatchApplier.cs" />
    <Compile Include="../src/Patches.cs" Link="Shared/Patches.cs" />
    <Compile Include="../src/LauncherConfig.cs" Link="Shared/LauncherConfig.cs" />
    <Compile Include="../src/Registro.cs" Link="Shared/Registro.cs" />
    <Compile Include="../src/SavesPorEquipes.cs" Link="Shared/SavesPorEquipes.cs" />
    <Compile Include="../src/Atualizacao.cs" Link="Shared/Atualizacao.cs" />
    <!-- Windows (portatil): injecao do ScreenHook.dll, como no launcher classico -->
    <Compile Include="../src/DllInjector.cs" Link="Shared/DllInjector.cs" />
    <EmbeddedResource Include="../linux/elifoot98.png" LogicalName="elifoot98.png" />
    <EmbeddedResource Include="../android/app/src/main/res/drawable-nodpi/logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="../game/REFEREE.TXE" LogicalName="REFEREE.TXE" />
    <!-- Windows (.exe unico): jogo, otvdm, fontes e ScreenHook (scripts/build-windows-portatil.sh) -->
    <EmbeddedResource Include="$(PacotePortatil)" LogicalName="pacote.zip" Condition="'$(PacotePortatil)' != ''" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>
</Project>
