<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- So para ver se ha versao nova (elifoot98.web.app/versao.json); o jogo roda offline -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Atualizacao: abrir o instalador do sistema com o APK novo baixado pelo launcher -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Elifoot 98"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="Elifoot 98">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RefereeEditorActivity"
            android:label="Editor de Árbitros"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:exported="false" />

        <activity
            android:name=".SaveEditorActivity"
            android:label="Editor de Save"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".TeamEditorActivity"
            android:label="Editor de Equipes"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ConfiguracoesActivity"
            android:label="Configurações"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:exported="false" />
        <activity
            android:name=".ScoutActivity"
            android:label="Scout"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name=".ApkProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Boxedwine/SDL num processo proprio: encerrado ao sair do jogo -->
        <activity
            android:name=".ElifootActivity"
            android:process=":jogo"
            android:exported="false"
            android:label="Elifoot 98"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="fullUser"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true" />
    </application>
</manifest>
