+// Letterbox (-fullscreenAspect): centraliza de novo quando a area de desenho muda
+// (Android: retrato/paisagem, ou so a area acima dos controles)
+void KNativeInputSDL::ajustarAspecto(U32 w, U32 h) {
+    if (!aspecto || !width || !height || !w || !h || (w == aspectoW && h == aspectoH)) {
+        return;
+    }
+    aspectoW = w;
+    aspectoH = h;
+    scaleX = w * 100 / width;
+    scaleY = h * 100 / height;
+    scaleXOffset = 0;
+    scaleYOffset = 0;
+    if (scaleY > scaleX) {
+        scaleY = scaleX;
+        scaleYOffset = (h - height * scaleY / 100) / 2;
+    } else if (scaleX > scaleY) {
+        scaleX = scaleY;
+        scaleXOffset = (w - width * scaleX / 100) / 2;
+    }
+}
