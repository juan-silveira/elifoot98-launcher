+
+// rep movs/stos com enderecamento de 32 bits, no sentido crescente: em blocos de
+// ate uma pagina, direto na memoria do host (o Wine usa muito, ao desenhar). Uma
+// pagina que nao e RAM comum (sem permissao, invalida) volta ao caminho de um
+// elemento por vez, que gera a falha certa no ponto certo.
+static inline U32 bytesNaPagina(U32 address) {
+    return K_PAGE_SIZE - (address & K_PAGE_MASK);
+}
+
+static void movs32rBlocos(CPU* cpu, U32 base, U32 width) {
+    U32 dBase = cpu->seg[ES].address;
+    U32 sBase = cpu->seg[base].address;
+    while (ECX) {
+        U32 d = dBase + EDI, s = sBase + ESI;
+        U32 n = std::min(bytesNaPagina(d), bytesNaPagina(s)) / width;
+        if (n > ECX) n = ECX;
+        if (!n) return;
+        U32 len = n * width;
+        U8* pd = cpu->memory->getRamPtr(d, len, true);
+        if (!pd) return;
+        U8* ps = cpu->memory->getRamPtr(s, len, false);
+        if (!ps) return;
+        if (d > s && d < s + len) {
+            // sobreposto com o destino a frente: o rep movs repete o padrao (com
+            // palavras de 2 ou 4 bytes, o caminho de um elemento por vez faz igual)
+            if (width != 1) return;
+            for (U32 i = 0; i < len; i++) pd[i] = ps[i];
+        } else {
+            ::memmove(pd, ps, len);
+        }
+        EDI += len;
+        ESI += len;
+        ECX -= n;
+    }
+}
+
+static void stos32rBlocos(CPU* cpu, U32 width, U32 value) {
+    U32 dBase = cpu->seg[ES].address;
+    while (ECX) {
+        U32 d = dBase + EDI;
+        U32 n = bytesNaPagina(d) / width;
+        if (n > ECX) n = ECX;
+        if (!n) return;
+        U32 len = n * width;
+        U8* pd = cpu->memory->getRamPtr(d, len, true);
+        if (!pd) return;
+        if (width == 1) {
+            ::memset(pd, (U8)value, len);
+        } else {
+            for (U32 i = 0; i < len; i += width) ::memcpy(pd + i, &value, width);
+        }
+        EDI += len;
+        ECX -= n;
+    }
+}
